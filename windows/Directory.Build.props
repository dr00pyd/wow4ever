<Project>
  <!--
    Variant av klienten (samma kod): -p:ScoutVariant=full (standard), -p:ScoutVariant=lite eller -p:ScoutVariant=store.
      full = fristående (self-contained) single-file exe, inget att installera (~105 MB).
      lite = ramverksberoende single-file exe (~2 MB), kräver .NET 10 Desktop Runtime.
      store = som full, men för Microsoft Store (MSIX, tools/make-msix.mjs): ingen egen exe-uppdatering (Store sköter den),
              autostart via MSIX startup task. Konstanten SCOUT_STORE.
    Alla: win-x64, ingen komprimering/packning, ingen trimning. Konstanterna SCOUT_LITE/SCOUT_STORE styr BuildInfo.Variant.
  -->
  <PropertyGroup>
    <ScoutVariant Condition="'$(ScoutVariant)' == ''">full</ScoutVariant>
    <!-- Egna obj/bin per variant, så att ett inkrementellt bygge aldrig blandar ihop SCOUT_LITE och full. -->
    <BaseIntermediateOutputPath>obj\$(ScoutVariant)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(ScoutVariant)\</BaseOutputPath>
    <!-- Den andra variantens obj/bin får aldrig räknas som källkod. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
